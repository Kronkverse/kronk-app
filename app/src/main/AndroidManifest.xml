<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Receive FCM messages routed through Google Services
         Framework. Only the GSF process (which holds the
         .permission.SEND permission) can broadcast to us. -->
    <uses-permission android:name="com.google.android.c2dm.permission.RECEIVE" />
    <!-- Show system-tray notifications for incoming pushes.
         Requested at first-use on Android 13+; auto-granted on
         Android 12 and below. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Foreground service to keep the process alive while the
         WebView is playing audio (Booth DJ sets, Moments voice,
         Huddle voice, Cinema playback). Without this Android
         kills the app on backgrounding and audio stops. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Nudges voice messages + Moments voice recording. Requested at
         first-use, not on install; users who never touch a voice input
         are never prompted. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Camera intents ACTION_IMAGE_CAPTURE / ACTION_VIDEO_CAPTURE
         don't need this permission themselves, but getUserMedia({video:
         true}) from the WebView (Huddle, future live-video features)
         does. Requested at first-use. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Camera / video capture requests use ACTION_IMAGE_CAPTURE and
         ACTION_VIDEO_CAPTURE which don't need the CAMERA permission
         (the camera app owns that). But declaring the feature as
         optional means the app still installs on tablets without a
         camera; capture intents just fail gracefully. -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />

    <application
        android:name=".KronkApplication"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Kronk2.Splash">

        <activity
            android:name="info.kronk.app.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Kronk2.Splash"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- kronk-auth://callback — OAuth redirect target. Chrome
                 Custom Tab hands control back to us here after the
                 user completes /oauth/authorize on kronk.info.
                 launchMode=singleTask keeps the activity the same
                 instance so onNewIntent picks up the code. -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="kronk-auth" android:host="callback" />
            </intent-filter>

            <!-- https://kronk.info/* and https://shadow.kronk.info/* —
                 tapping any Kronk link in email, chat, another app
                 opens the app on the matching pillar. autoVerify="true"
                 lets the app appear as the default handler once the
                 Digital Asset Links `.well-known/assetlinks.json` is
                 served from the host (Kronkverse infra follow-up);
                 until then the user picks the app from the resolver
                 sheet. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="kronk.info" />
                <data android:host="shadow.kronk.info" />
            </intent-filter>

            <!-- ACTION_SEND — user shares something from another app
                 ("Share to Kronk") and lands in the composer. Text,
                 image, video, audio all supported. The Activity
                 dispatches to a Kronk-side compose URL with the
                 shared payload as a query param + attachment stream. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/*" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
                <data android:mimeType="audio/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
            </intent-filter>
        </activity>

        <!-- Background audio sentinel — keeps the app process alive
             while the WebView is playing media. Started via
             KronkJsBridge when the SPA's audio/video elements fire
             their `play` event; stopped when all of them pause. -->
        <service
            android:name="info.kronk.app.audio.KronkAudioService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- FCM-via-GSF: receives the token after
             FcmRegistrar.requestToken and stashes it in
             PushTokenStore. The .permission.SEND filter restricts
             the sender to Google Services Framework. -->
        <receiver
            android:name="info.kronk.app.push.FcmRegistrar$RegistrationReceiver"
            android:exported="true"
            android:permission="com.google.android.c2dm.permission.SEND">
            <intent-filter>
                <action android:name="com.google.android.c2dm.intent.REGISTRATION" />
                <category android:name="info.kronk.app" />
            </intent-filter>
        </receiver>

        <!-- FCM-via-GSF: receives actual push payloads. Same
             .permission.SEND restriction. Payload is an encrypted
             Web Push blob (RFC 8291); decrypt path lands in
             push commit #3. -->
        <receiver
            android:name="info.kronk.app.push.FcmRegistrar$MessageReceiver"
            android:exported="true"
            android:permission="com.google.android.c2dm.permission.SEND">
            <intent-filter>
                <action android:name="com.google.android.c2dm.intent.RECEIVE" />
                <category android:name="info.kronk.app" />
            </intent-filter>
        </receiver>

        <!-- UnifiedPush MessagingReceiver. Registered via manifest so
             the OS can broadcast push events to us even when the
             process is dead — the whole point of push. Actions
             below come from the UnifiedPush spec:
               MESSAGE          — payload from the distributor
               NEW_ENDPOINT     — endpoint URL to give Kronk
               REGISTRATION_FAILED — distributor rejected us
               UNREGISTERED     — distributor cleared us -->
        <receiver
            android:name="info.kronk.app.push.KronkMessagingReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="org.unifiedpush.android.connector.MESSAGE" />
                <action android:name="org.unifiedpush.android.connector.NEW_ENDPOINT" />
                <action android:name="org.unifiedpush.android.connector.REGISTRATION_FAILED" />
                <action android:name="org.unifiedpush.android.connector.UNREGISTERED" />
            </intent-filter>
        </receiver>

        <!-- FileProvider for camera/mic capture. Writes into the app's
             cache dir (see res/xml/file_paths.xml) and hands the
             WebView a content:// URI it can upload via the existing
             `<input type="file">` flow. Authority is the app's
             package + `.captures` — reads from BuildConfig at
             runtime so debug and release get distinct authorities
             (`info.kronk.app.next.debug.captures` vs
             `info.kronk.app.captures`) and can coexist. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.captures"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
