<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".KronkApplication"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Kronk2.Splash">

        <activity
            android:name="info.kronk.app.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Kronk2.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- kronk-auth://callback — OAuth redirect target. Chrome
                 Custom Tab hands control back to us here after the
                 user completes /oauth/authorize on kronk.info.
                 launchMode=singleTask keeps the activity the same
                 instance so onNewIntent picks up the code. -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="kronk-auth" android:host="callback" />
            </intent-filter>
        </activity>

    </application>

</manifest>
