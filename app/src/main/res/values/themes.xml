<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Splash-only Android theme (pre-Compose). Sets the window
        background to the Kronk surface colour so the transition from
        launcher to the Compose welcome pane doesn't flash a white
        square. Once Compose takes over, KronkTheme paints the
        surface itself.
    -->
    <style name="Theme.Kronk2.Splash" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/surface_primary_dark</item>
        <item name="android:statusBarColor">@color/surface_primary_dark</item>
        <item name="android:navigationBarColor">@color/surface_primary_dark</item>
    </style>
</resources>
