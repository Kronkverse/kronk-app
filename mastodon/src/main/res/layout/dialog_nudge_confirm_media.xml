<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:orientation="vertical"
	android:padding="20dp">

	<!-- Image preview -->
	<ImageView
		android:id="@+id/confirm_image"
		android:layout_width="match_parent"
		android:layout_height="240dp"
		android:scaleType="centerCrop"
		android:background="@drawable/bg_compose_nudge_input"
		android:clipToOutline="true"
		android:visibility="gone"/>

	<!-- Video preview -->
	<VideoView
		android:id="@+id/confirm_video"
		android:layout_width="match_parent"
		android:layout_height="220dp"
		android:visibility="gone"/>

	<!-- Voice preview -->
	<LinearLayout
		android:id="@+id/confirm_voice_container"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="horizontal"
		android:gravity="center_vertical"
		android:background="@drawable/bg_compose_nudge_input"
		android:padding="16dp"
		android:visibility="gone">

		<ImageButton
			android:id="@+id/confirm_voice_play_btn"
			android:layout_width="44dp"
			android:layout_height="44dp"
			android:background="?attr/colorM3Primary"
			android:src="@drawable/ic_play_24"
			android:tint="?attr/colorM3OnPrimary"
			android:padding="10dp"
			android:contentDescription="@string/nudge_play_voice"/>

		<TextView
			android:id="@+id/confirm_voice_duration"
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_weight="1"
			android:layout_marginStart="12dp"
			android:textSize="15sp"
			android:textColor="?attr/colorM3OnSurface"/>

	</LinearLayout>

	<TextView
		android:id="@+id/confirm_caption"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="16dp"
		android:textSize="15sp"
		android:textColor="?attr/colorM3OnSurface"
		android:gravity="center"/>

</LinearLayout>
