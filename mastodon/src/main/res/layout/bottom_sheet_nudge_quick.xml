<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:orientation="vertical"
	android:paddingHorizontal="24dp"
	android:paddingTop="24dp"
	android:paddingBottom="32dp"
	android:gravity="center_horizontal">

	<ImageView
		android:id="@+id/sheet_avatar"
		android:layout_width="72dp"
		android:layout_height="72dp"
		android:scaleType="centerCrop"
		android:importantForAccessibility="no"
		android:src="@drawable/image_placeholder"/>

	<TextView
		android:id="@+id/sheet_name"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_marginTop="12dp"
		android:textSize="18sp"
		android:textStyle="bold"
		android:textColor="@color/kronk_nudge_text"
		android:gravity="center"/>

	<TextView
		android:id="@+id/sheet_username"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_marginTop="2dp"
		android:textSize="14sp"
		android:textColor="@color/kronk_nudge_text_muted"
		android:gravity="center"/>

	<LinearLayout
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:orientation="horizontal"
		android:layout_marginTop="8dp"
		android:gravity="center_vertical">

		<TextView
			android:id="@+id/sheet_streak_sent"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:textSize="13sp"
			android:textColor="@color/kronk_nudge_brand"/>

		<TextView
			android:id="@+id/sheet_streak_received"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginStart="12dp"
			android:textSize="13sp"
			android:textColor="@color/kronk_nudge_brand"/>

	</LinearLayout>

	<Button
		android:id="@+id/sheet_nudge_btn"
		android:layout_width="match_parent"
		android:layout_height="52dp"
		android:layout_marginTop="20dp"
		android:textSize="16sp"
		android:textAllCaps="false"
		style="@style/Widget.Mastodon.M3.Button"/>

	<Button
		android:id="@+id/sheet_profile_btn"
		android:layout_width="match_parent"
		android:layout_height="44dp"
		android:layout_marginTop="8dp"
		android:textSize="14sp"
		android:textAllCaps="false"
		android:text="@string/nudge_view_profile"
		style="@style/Widget.Mastodon.M3.Button.Text"/>

</LinearLayout>
