<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:orientation="vertical">

	<!-- Back bar -->
	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="horizontal"
		android:gravity="center_vertical"
		android:paddingStart="4dp"
		android:paddingEnd="16dp"
		android:paddingVertical="8dp">

		<ImageButton
			android:id="@+id/btn_back"
			android:layout_width="48dp"
			android:layout_height="48dp"
			android:src="@drawable/ic_arrow_back_24px"
			android:tint="?colorM3OnSurface"
			android:background="?selectableItemBackgroundBorderless"
			android:contentDescription="@string/back"/>

		<TextView
			android:id="@+id/detail_header_title"
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_weight="1"
			android:layout_marginStart="4dp"
			android:textAppearance="@style/m3_title_large"
			android:textColor="?colorM3OnSurface"
			android:singleLine="true"
			android:ellipsize="end"
			tools:text="Add a community calendar"/>

	</LinearLayout>

	<!-- Scrollable content -->
	<androidx.core.widget.NestedScrollView
		android:layout_width="match_parent"
		android:layout_height="0dp"
		android:layout_weight="1">

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical"
			android:paddingHorizontal="20dp"
			android:paddingBottom="24dp">

			<!-- Status + meta -->
			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="horizontal"
				android:gravity="center_vertical"
				android:layout_marginBottom="12dp">

				<TextView
					android:id="@+id/detail_status"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:paddingHorizontal="8dp"
					android:paddingVertical="3dp"
					android:textSize="11sp"
					android:textStyle="bold"
					android:textAllCaps="true"
					android:letterSpacing="0.04"
					android:background="@drawable/bg_inline_status"
					tools:text="OPEN"/>

				<TextView
					android:id="@+id/detail_meta"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginStart="10dp"
					android:textAppearance="@style/m3_body_small"
					android:textColor="?colorM3OnSurfaceVariant"
					tools:text="by @talita · May 1"/>

			</LinearLayout>

			<!-- Body -->
			<TextView
				android:id="@+id/detail_body"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:textAppearance="@style/m3_body_medium"
				android:textColor="?colorM3OnSurface"
				android:lineSpacingMultiplier="1.5"
				android:layout_marginBottom="20dp"
				tools:text="A shared events calendar where members can post and browse upcoming community events."/>

			<!-- Vote section -->
			<TextView
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="@string/kommons_your_vote"
				android:textAppearance="@style/m3_title_small"
				android:textColor="?colorM3OnSurface"
				android:layout_marginBottom="10dp"/>

			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="horizontal">

				<Button
					android:id="@+id/btn_agree"
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_weight="1"
					android:layout_marginEnd="6dp"
					android:text="@string/kommons_agree"
					android:textSize="13sp"
					android:stateListAnimator="@null"
					style="@style/Widget.Material3.Button.OutlinedButton"/>

				<Button
					android:id="@+id/btn_abstain"
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_weight="1"
					android:layout_marginHorizontal="3dp"
					android:text="@string/kommons_abstain"
					android:textSize="13sp"
					android:stateListAnimator="@null"
					style="@style/Widget.Material3.Button.OutlinedButton"/>

				<Button
					android:id="@+id/btn_block"
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_weight="1"
					android:layout_marginStart="6dp"
					android:text="@string/kommons_block"
					android:textSize="13sp"
					android:stateListAnimator="@null"
					style="@style/Widget.Material3.Button.OutlinedButton"/>

			</LinearLayout>

			<!-- Vote tally -->
			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="horizontal"
				android:gravity="center"
				android:layout_marginTop="10dp"
				android:layout_marginBottom="20dp">

				<TextView
					android:id="@+id/tally_agree"
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_weight="1"
					android:gravity="center"
					android:textAppearance="@style/m3_body_small"
					android:textColor="?colorM3Primary"
					tools:text="12 agree"/>

				<TextView
					android:id="@+id/tally_abstain"
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_weight="1"
					android:gravity="center"
					android:textAppearance="@style/m3_body_small"
					android:textColor="?colorM3OnSurfaceVariant"
					tools:text="3 abstain"/>

				<TextView
					android:id="@+id/tally_block"
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_weight="1"
					android:gravity="center"
					android:textAppearance="@style/m3_body_small"
					android:textColor="?colorM3Error"
					tools:text="1 block"/>

			</LinearLayout>

			<!-- Voters section -->
			<TextView
				android:id="@+id/voters_heading"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="@string/kommons_votes"
				android:textAppearance="@style/m3_title_small"
				android:textColor="?colorM3OnSurface"
				android:layout_marginBottom="8dp"
				android:visibility="gone"/>

			<LinearLayout
				android:id="@+id/voters_list"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="vertical"
				android:layout_marginBottom="20dp"/>

			<!-- Challenges section -->
			<TextView
				android:id="@+id/challenges_heading"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="@string/kommons_challenges"
				android:textAppearance="@style/m3_title_small"
				android:textColor="?colorM3OnSurface"
				android:layout_marginBottom="8dp"
				android:visibility="gone"/>

			<LinearLayout
				android:id="@+id/challenges_list"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="vertical"/>

		</LinearLayout>

	</androidx.core.widget.NestedScrollView>

</LinearLayout>
