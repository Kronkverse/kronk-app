<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:orientation="vertical"
	android:paddingHorizontal="16dp"
	android:paddingTop="24dp"
	android:paddingBottom="6dp">

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="vertical"
		android:paddingHorizontal="14dp"
		android:paddingVertical="14dp"
		android:background="@drawable/bg_nudge_stats_card">

		<!-- Grand Total -->
		<TextView
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:gravity="center"
			android:textSize="10sp"
			android:letterSpacing="0.08"
			android:textAllCaps="true"
			android:textStyle="bold"
			android:textColor="@color/kronk_nudge_text_muted"
			android:text="@string/nudge_grand_total_title"/>

		<TextView
			android:id="@+id/grand_total_number"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="2dp"
			android:gravity="center"
			android:textSize="34sp"
			android:textStyle="bold"
			android:lineHeight="36sp"
			android:textColor="@color/kronk_nudge_gold"/>

		<!-- Subtle divider matching web's lighten(base, 8%) -->
		<View
			android:layout_width="match_parent"
			android:layout_height="1dp"
			android:layout_marginTop="12dp"
			android:layout_marginBottom="10dp"
			android:background="@color/kronk_nudge_base"/>

		<!-- Sent / Received -->
		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="horizontal"
			android:gravity="center_vertical">

			<LinearLayout
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_weight="1"
				android:orientation="vertical"
				android:gravity="center_horizontal">

				<TextView
					android:id="@+id/total_sent_number"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:gravity="center"
					android:textSize="20sp"
					android:textStyle="bold"
					android:lineHeight="22sp"
					android:textColor="@color/kronk_nudge_brand"/>

				<TextView
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="2dp"
					android:gravity="center"
					android:textSize="10sp"
					android:letterSpacing="0.08"
					android:textStyle="bold"
					android:textAllCaps="true"
					android:textColor="@color/kronk_nudge_text_muted"
					android:text="@string/nudge_total_sent"/>

			</LinearLayout>

			<View
				android:layout_width="1dp"
				android:layout_height="32dp"
				android:background="@color/kronk_nudge_base"
				android:layout_marginHorizontal="8dp"/>

			<LinearLayout
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_weight="1"
				android:orientation="vertical"
				android:gravity="center_horizontal">

				<TextView
					android:id="@+id/total_received_number"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:gravity="center"
					android:textSize="20sp"
					android:textStyle="bold"
					android:lineHeight="22sp"
					android:textColor="@color/kronk_nudge_brand"/>

				<TextView
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="2dp"
					android:gravity="center"
					android:textSize="10sp"
					android:letterSpacing="0.08"
					android:textStyle="bold"
					android:textAllCaps="true"
					android:textColor="@color/kronk_nudge_text_muted"
					android:text="@string/nudge_total_received"/>

			</LinearLayout>

		</LinearLayout>

		<TextView
			android:id="@+id/pending_hint"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_gravity="center_horizontal"
			android:layout_marginTop="12dp"
			android:paddingHorizontal="10dp"
			android:paddingVertical="4dp"
			android:textSize="12sp"
			android:textStyle="bold"
			android:textColor="@color/kronk_nudge_base_darker"
			android:background="@drawable/bg_nudge_pending_badge"
			android:visibility="gone"/>

	</LinearLayout>

</LinearLayout>
