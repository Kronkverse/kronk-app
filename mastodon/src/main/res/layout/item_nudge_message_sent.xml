<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:orientation="horizontal"
	android:gravity="end"
	android:paddingVertical="2dp">

	<LinearLayout
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:orientation="vertical"
		android:maxWidth="260dp"
		android:gravity="end">

		<LinearLayout
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:orientation="vertical"
			android:maxWidth="260dp"
			android:background="@drawable/bg_nudge_bubble_sent"
			android:paddingHorizontal="13dp"
			android:paddingTop="9dp"
			android:paddingBottom="6dp">

			<!-- Reply quote (visible only when in_reply_to set) -->
			<LinearLayout
				android:id="@+id/reply_quote"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="horizontal"
				android:gravity="center_vertical"
				android:background="@drawable/bg_nudge_reply_quote_sent"
				android:paddingHorizontal="8dp"
				android:paddingVertical="4dp"
				android:layout_marginBottom="4dp"
				android:visibility="gone">

				<TextView
					android:id="@+id/reply_quote_icon"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:textSize="11sp"
					android:layout_marginEnd="4dp"
					android:visibility="gone"/>

				<TextView
					android:id="@+id/reply_quote_body"
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_weight="1"
					android:textSize="11sp"
					android:textColor="@color/kronk_nudge_base_darker"
					android:alpha="0.85"
					android:maxLines="2"
					android:ellipsize="end"/>

			</LinearLayout>

			<TextView
				android:id="@+id/message_text"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:textSize="14sp"
				android:textColor="@color/kronk_nudge_base_darker"
				android:lineSpacingMultiplier="1.3"
				android:visibility="gone"/>

			<ImageView
				android:id="@+id/message_image"
				android:layout_width="220dp"
				android:layout_height="180dp"
				android:scaleType="centerCrop"
				android:background="@drawable/bg_compose_nudge_input"
				android:clipToOutline="true"
				android:visibility="gone"/>

			<FrameLayout
				android:id="@+id/message_video_container"
				android:layout_width="220dp"
				android:layout_height="160dp"
				android:visibility="gone">

				<VideoView
					android:id="@+id/message_video"
					android:layout_width="match_parent"
					android:layout_height="match_parent"/>

			</FrameLayout>

			<TextView
				android:id="@+id/message_voice_legacy"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:textSize="14sp"
				android:textColor="@color/kronk_nudge_base_darker"
				android:alpha="0.85"
				android:text="🎤 Voice message"
				android:visibility="gone"/>

			<!-- Footer: time + expiry countdown + status (tick/Seen) -->
			<LinearLayout
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_gravity="end"
				android:orientation="horizontal"
				android:gravity="center_vertical"
				android:layout_marginTop="3dp">

				<TextView
					android:id="@+id/message_time"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:textSize="11sp"
					android:alpha="0.7"
					android:textColor="@color/kronk_nudge_base_darker"/>

				<TextView
					android:id="@+id/message_status"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginStart="6dp"
					android:textSize="11sp"
					android:textColor="@color/kronk_nudge_base_darker"
					android:alpha="0.7"
					android:visibility="gone"/>

			</LinearLayout>

		</LinearLayout>

		<!-- Reactions row (3 fixed emoji) -->
		<LinearLayout
			android:id="@+id/reactions_row"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:orientation="horizontal"
			android:gravity="end"
			android:layout_marginTop="3dp"
			android:visibility="gone">

			<TextView
				android:id="@+id/reaction_btn_0"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:minWidth="32dp"
				android:gravity="center"
				android:textSize="13sp"
				android:textColor="@color/kronk_nudge_text"
				android:background="@drawable/bg_nudge_reaction_chip"
				android:paddingHorizontal="7dp"
				android:paddingVertical="2dp"
				android:layout_marginEnd="3dp"
				android:clickable="true"
				android:focusable="true"/>

			<TextView
				android:id="@+id/reaction_btn_1"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:minWidth="32dp"
				android:gravity="center"
				android:textSize="13sp"
				android:textColor="@color/kronk_nudge_text"
				android:background="@drawable/bg_nudge_reaction_chip"
				android:paddingHorizontal="7dp"
				android:paddingVertical="2dp"
				android:layout_marginEnd="3dp"
				android:clickable="true"
				android:focusable="true"/>

			<TextView
				android:id="@+id/reaction_btn_2"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:minWidth="32dp"
				android:gravity="center"
				android:textSize="13sp"
				android:textColor="@color/kronk_nudge_text"
				android:background="@drawable/bg_nudge_reaction_chip"
				android:paddingHorizontal="7dp"
				android:paddingVertical="2dp"
				android:clickable="true"
				android:focusable="true"/>

		</LinearLayout>

	</LinearLayout>

</LinearLayout>
