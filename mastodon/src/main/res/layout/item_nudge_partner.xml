<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:orientation="horizontal"
	android:paddingHorizontal="16dp"
	android:paddingVertical="12dp"
	android:gravity="center_vertical">

	<FrameLayout
		android:layout_width="52dp"
		android:layout_height="52dp">

		<ImageView
			android:id="@+id/avatar"
			android:layout_width="46dp"
			android:layout_height="46dp"
			android:layout_gravity="top|start"
			android:scaleType="centerCrop"
			android:importantForAccessibility="no"
			android:src="@drawable/image_placeholder"/>

		<ImageView
			android:id="@+id/wave_icon"
			android:layout_width="22dp"
			android:layout_height="22dp"
			android:layout_gravity="bottom|end"
			android:scaleType="centerInside"
			android:importantForAccessibility="no"
			android:src="@drawable/ic_partner_exchange_24px"
			android:background="@drawable/bg_nudge_wave_badge"
			android:padding="3dp"/>

	</FrameLayout>

	<LinearLayout
		android:layout_width="0dp"
		android:layout_height="wrap_content"
		android:layout_weight="1"
		android:orientation="vertical"
		android:layout_marginStart="12dp">

		<TextView
			android:id="@+id/display_name"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:textSize="15sp"
			android:textStyle="bold"
			android:textColor="?attr/colorM3OnSurface"
			android:singleLine="true"
			android:ellipsize="end"/>

		<TextView
			android:id="@+id/username"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:textSize="13sp"
			android:textColor="?colorM3OnSurfaceVariant"
			android:singleLine="true"
			android:ellipsize="end"/>

		<LinearLayout
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:orientation="horizontal"
			android:layout_marginTop="3dp"
			android:gravity="center_vertical">

			<TextView
				android:id="@+id/streak_sent"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:textSize="12sp"
				android:textColor="?attr/colorM3Primary"/>

			<TextView
				android:id="@+id/streak_received"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginStart="10dp"
				android:textSize="12sp"
				android:textColor="?attr/colorM3Tertiary"/>

		</LinearLayout>

		<TextView
			android:id="@+id/nudge_timestamp"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginTop="1dp"
			android:textSize="11sp"
			android:textColor="?colorM3OnSurfaceVariant"
			android:alpha="0.65"
			android:visibility="gone"/>

	</LinearLayout>

	<Button
		android:id="@+id/nudge_btn"
		android:layout_width="wrap_content"
		android:layout_height="36dp"
		android:layout_marginStart="10dp"
		android:paddingHorizontal="14dp"
		android:textSize="13sp"
		android:textAllCaps="false"
		style="@style/Widget.Mastodon.M3.Button.Tonal"/>

</LinearLayout>
