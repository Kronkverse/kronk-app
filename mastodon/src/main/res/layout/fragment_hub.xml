<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:fillViewport="true">

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="vertical"
		android:padding="20dp">

		<TextView
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:text="@string/spaces"
			android:textSize="28sp"
			android:textStyle="bold"
			android:textColor="?colorM3OnSurface"
			android:layout_marginTop="8dp"
			android:layout_marginBottom="20dp"/>

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="horizontal"
			android:layout_marginBottom="12dp">

			<FrameLayout
				android:id="@+id/tile_feed"
				android:layout_width="0dp"
				android:layout_height="140dp"
				android:layout_weight="1"
				android:layout_marginEnd="6dp"
				android:background="@drawable/bg_space_tile"
				android:clickable="true"
				android:focusable="true">

				<LinearLayout
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_gravity="center"
					android:orientation="vertical"
					android:gravity="center">

					<ImageView
						android:layout_width="40dp"
						android:layout_height="40dp"
						android:scaleType="center"
						android:importantForAccessibility="no"
						android:tint="?colorM3OnSecondaryContainer"
						android:src="@drawable/ic_feed_24px"/>

					<TextView
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_marginTop="8dp"
						android:text="@string/tab_home"
						android:textSize="14sp"
						android:textStyle="medium"
						android:textColor="?colorM3OnSecondaryContainer"/>

				</LinearLayout>
			</FrameLayout>

			<FrameLayout
				android:id="@+id/tile_events"
				android:layout_width="0dp"
				android:layout_height="140dp"
				android:layout_weight="1"
				android:layout_marginStart="6dp"
				android:background="@drawable/bg_space_tile"
				android:clickable="true"
				android:focusable="true">

				<LinearLayout
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_gravity="center"
					android:orientation="vertical"
					android:gravity="center">

					<ImageView
						android:layout_width="40dp"
						android:layout_height="40dp"
						android:scaleType="center"
						android:importantForAccessibility="no"
						android:tint="?colorM3OnSecondaryContainer"
						android:src="@drawable/ic_tab_events"/>

					<TextView
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_marginTop="8dp"
						android:text="@string/tab_events"
						android:textSize="14sp"
						android:textStyle="medium"
						android:textColor="?colorM3OnSecondaryContainer"/>

				</LinearLayout>
			</FrameLayout>

		</LinearLayout>

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="horizontal">

			<FrameLayout
				android:id="@+id/tile_huddle"
				android:layout_width="0dp"
				android:layout_height="140dp"
				android:layout_weight="1"
				android:layout_marginEnd="6dp"
				android:background="@drawable/bg_space_tile"
				android:clickable="true"
				android:focusable="true">

				<LinearLayout
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_gravity="center"
					android:orientation="vertical"
					android:gravity="center">

					<ImageView
						android:layout_width="40dp"
						android:layout_height="40dp"
						android:scaleType="center"
						android:importantForAccessibility="no"
						android:tint="?colorM3OnSecondaryContainer"
						android:src="@drawable/ic_tab_live"/>

					<TextView
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_marginTop="8dp"
						android:text="@string/tab_live"
						android:textSize="14sp"
						android:textStyle="medium"
						android:textColor="?colorM3OnSecondaryContainer"/>

				</LinearLayout>
			</FrameLayout>

			<FrameLayout
				android:id="@+id/tile_kommons"
				android:layout_width="0dp"
				android:layout_height="140dp"
				android:layout_weight="1"
				android:layout_marginStart="6dp"
				android:background="@drawable/bg_space_tile"
				android:clickable="true"
				android:focusable="true">

				<LinearLayout
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_gravity="center"
					android:orientation="vertical"
					android:gravity="center">

					<ImageView
						android:layout_width="40dp"
						android:layout_height="40dp"
						android:scaleType="center"
						android:importantForAccessibility="no"
						android:tint="?colorM3OnSecondaryContainer"
						android:src="@drawable/ic_gavel_24px"/>

					<TextView
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_marginTop="8dp"
						android:text="@string/kommons_space"
						android:textSize="14sp"
						android:textStyle="medium"
						android:textColor="?colorM3OnSecondaryContainer"/>

				</LinearLayout>
			</FrameLayout>

		</LinearLayout>

	</LinearLayout>

</ScrollView>
