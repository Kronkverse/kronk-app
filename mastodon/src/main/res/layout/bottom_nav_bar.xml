<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:id="@+id/bottom_nav_wrap"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:background="@drawable/bg_tabbar"
	android:elevation="3dp"
	android:outlineProvider="bounds"
	android:clipChildren="false">

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="80dp"
		android:orientation="horizontal">

		<FrameLayout
			android:id="@+id/nav_profile"
			android:layout_width="0dp"
			android:layout_height="match_parent"
			android:layout_weight="1"
			android:background="@drawable/bg_tabbar_tab"
			android:paddingHorizontal="4dp"
			android:contentDescription="@string/tab_profile"
			android:clickable="true"
			android:focusable="true">

			<ImageView
				android:layout_width="32dp"
				android:layout_height="32dp"
				android:layout_gravity="top|center_horizontal"
				android:layout_marginTop="12dp"
				android:scaleType="center"
				android:importantForAccessibility="no"
				android:duplicateParentState="true"
				android:tint="@color/tab_bar_icon"
				android:src="@drawable/ic_tab_profile"/>

			<TextView
				android:id="@+id/label"
				android:layout_width="match_parent"
				android:layout_height="16dp"
				android:layout_marginBottom="16dp"
				android:layout_gravity="bottom"
				android:gravity="center"
				android:textSize="12dp"
				android:textColor="@color/nav_item_color"
				android:duplicateParentState="true"
				android:singleLine="true"
				android:ellipsize="end"
				android:text="@string/tab_profile"/>

		</FrameLayout>

		<FrameLayout
			android:id="@+id/nav_hub"
			android:layout_width="0dp"
			android:layout_height="match_parent"
			android:layout_weight="1"
			android:background="@drawable/bg_tabbar_tab"
			android:paddingHorizontal="4dp"
			android:contentDescription="@string/tab_hub"
			android:clickable="true"
			android:focusable="true">

			<ImageView
				android:layout_width="32dp"
				android:layout_height="32dp"
				android:layout_gravity="top|center_horizontal"
				android:layout_marginTop="12dp"
				android:scaleType="center"
				android:importantForAccessibility="no"
				android:duplicateParentState="true"
				android:tint="@color/tab_bar_icon"
				android:src="@drawable/ic_tab_hub"/>

			<TextView
				android:id="@+id/label"
				android:layout_width="match_parent"
				android:layout_height="16dp"
				android:layout_marginBottom="16dp"
				android:layout_gravity="bottom"
				android:gravity="center"
				android:textSize="12dp"
				android:textColor="@color/nav_item_color"
				android:duplicateParentState="true"
				android:singleLine="true"
				android:ellipsize="end"
				android:text="@string/tab_hub"/>

		</FrameLayout>

		<FrameLayout
			android:id="@+id/nav_notifications"
			android:layout_width="0dp"
			android:layout_height="match_parent"
			android:layout_weight="1"
			android:background="@drawable/bg_tabbar_tab"
			android:paddingHorizontal="4dp"
			android:contentDescription="@string/notifications"
			android:clickable="true"
			android:focusable="true">

			<ImageView
				android:layout_width="32dp"
				android:layout_height="32dp"
				android:layout_gravity="top|center_horizontal"
				android:layout_marginTop="12dp"
				android:scaleType="center"
				android:importantForAccessibility="no"
				android:duplicateParentState="true"
				android:tint="@color/tab_bar_icon"
				android:src="@drawable/ic_tab_notifications"/>

			<TextView
				android:id="@+id/label"
				android:layout_width="match_parent"
				android:layout_height="16dp"
				android:layout_marginBottom="16dp"
				android:layout_gravity="bottom"
				android:gravity="center"
				android:textSize="12dp"
				android:textColor="@color/nav_item_color"
				android:duplicateParentState="true"
				android:singleLine="true"
				android:ellipsize="end"
				android:text="@string/notifications"/>

		</FrameLayout>

	</LinearLayout>

</FrameLayout>
