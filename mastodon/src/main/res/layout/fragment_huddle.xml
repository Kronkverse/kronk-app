<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="match_parent">

	<!-- Lobby view -->
	<ScrollView
		android:id="@+id/lobby"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:fillViewport="true">

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical"
			android:gravity="center_horizontal"
			android:padding="40dp">

			<View
				android:layout_width="0dp"
				android:layout_height="0dp"
				android:layout_weight="1"/>

			<!-- Room icon -->
			<ImageView
				android:layout_width="96dp"
				android:layout_height="96dp"
				android:padding="24dp"
				android:src="@drawable/ic_diversity_2_24px"
				android:tint="#FFFFFF"
				android:background="@drawable/bg_huddle_icon"
				android:importantForAccessibility="no"/>

			<TextView
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginTop="32dp"
				android:text="@string/huddle_title"
				android:textSize="24sp"
				android:textStyle="bold"
				android:textColor="?android:textColorPrimary"/>

			<TextView
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginTop="8dp"
				android:maxWidth="320dp"
				android:gravity="center"
				android:text="@string/huddle_description"
				android:textSize="15sp"
				android:textColor="?android:textColorSecondary"
				android:lineSpacingMultiplier="1.4"/>

			<!-- Participant box -->
			<LinearLayout
				android:id="@+id/participant_box"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="32dp"
				android:maxWidth="320dp"
				android:orientation="vertical"
				android:gravity="center_horizontal"
				android:padding="16dp"
				android:background="@drawable/bg_huddle_participants"
				android:visibility="gone">

				<LinearLayout
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:orientation="horizontal"
					android:gravity="center_vertical">

					<View
						android:layout_width="8dp"
						android:layout_height="8dp"
						android:background="@drawable/bg_green_dot"/>

					<TextView
						android:id="@+id/participant_count"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_marginStart="6dp"
						android:textSize="13sp"
						android:textStyle="bold"
						android:textColor="?android:textColorPrimary"
						android:textAllCaps="true"
						android:letterSpacing="0.05"/>
				</LinearLayout>

				<TextView
					android:id="@+id/participant_names"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginTop="10dp"
					android:gravity="center"
					android:textSize="13sp"
					android:textStyle="bold"
					android:textColor="?android:textColorPrimary"/>
			</LinearLayout>

			<!-- Huddle Up button -->
			<Button
				android:id="@+id/huddle_button"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginTop="32dp"
				android:paddingHorizontal="48dp"
				android:paddingVertical="14dp"
				android:text="@string/huddle_join"
				android:textSize="16sp"
				android:textStyle="bold"
				android:textColor="#FFFFFF"
				android:background="@drawable/bg_huddle_button"
				android:stateListAnimator="@null"/>

			<TextView
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginTop="24dp"
				android:text="@string/huddle_powered_by"
				android:textSize="12sp"
				android:textColor="?android:textColorSecondary"
				android:alpha="0.6"/>

			<View
				android:layout_width="0dp"
				android:layout_height="0dp"
				android:layout_weight="1"/>

		</LinearLayout>
	</ScrollView>

	<!-- Jitsi WebView (hidden initially) -->
	<FrameLayout
		android:id="@+id/jitsi_container"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:visibility="gone">

		<!-- Header bar with leave button -->
		<LinearLayout
			android:id="@+id/room_header"
			android:layout_width="match_parent"
			android:layout_height="48dp"
			android:orientation="horizontal"
			android:gravity="center_vertical"
			android:paddingHorizontal="16dp"
			android:background="?android:colorBackground"
			android:elevation="2dp">

			<View
				android:layout_width="8dp"
				android:layout_height="8dp"
				android:background="@drawable/bg_green_dot"/>

			<TextView
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_weight="1"
				android:layout_marginStart="10dp"
				android:text="@string/huddle_title"
				android:textSize="15sp"
				android:textStyle="bold"
				android:textColor="?android:textColorPrimary"/>

			<Button
				android:id="@+id/leave_button"
				android:layout_width="wrap_content"
				android:layout_height="32dp"
				android:paddingHorizontal="16dp"
				android:text="@string/huddle_leave"
				android:textSize="13sp"
				android:textStyle="bold"
				android:textColor="?android:textColorPrimary"
				android:background="@drawable/bg_huddle_leave_button"
				android:stateListAnimator="@null"/>
		</LinearLayout>

		<FrameLayout
			android:id="@+id/webview_container"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:layout_marginTop="48dp"/>
	</FrameLayout>

</FrameLayout>
