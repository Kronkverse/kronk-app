<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
	<item android:state_selected="true">
		<shape>
			<solid android:color="?attr/colorM3PrimaryContainer"/>
			<corners android:radius="10dp"/>
			<stroke android:width="1dp" android:color="?attr/colorM3Primary"/>
		</shape>
	</item>
	<item>
		<shape>
			<solid android:color="?attr/colorM3SurfaceVariant"/>
			<corners android:radius="10dp"/>
			<stroke android:width="1dp" android:color="?attr/colorM3OutlineVariant"/>
		</shape>
	</item>
</selector>
