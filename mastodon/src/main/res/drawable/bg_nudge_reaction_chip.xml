<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
	<item android:state_selected="true">
		<shape>
			<solid android:color="@color/kronk_nudge_brand_tint"/>
			<corners android:radius="10dp"/>
			<stroke android:width="1dp" android:color="@color/kronk_nudge_brand"/>
		</shape>
	</item>
	<item>
		<shape>
			<solid android:color="@color/kronk_nudge_base_lighter"/>
			<corners android:radius="10dp"/>
			<stroke android:width="1dp" android:color="@color/kronk_nudge_base"/>
		</shape>
	</item>
</selector>
